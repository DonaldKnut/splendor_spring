# =============================================================================
# SPLENDOR PROJECT — Environment Variable Template
# Copy values into apps/school/.env and apps/ngo/.env
# Never commit real secrets.
# =============================================================================

# --- PostgreSQL (recommended) ---
# Local example after scripts/setup-postgres.ps1:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/splendor_school?schema=public"
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/splendor_ngo?schema=public"

# --- School (apps/school/.env) ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/splendor_school?schema=public"
NEXTAUTH_SECRET="replace-with-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
SCHOOL_APP_URL="http://localhost:3000"
SCHOOL_HEAD_ADMIN_EMAIL="admin@splendorschool.local"
SCHOOL_HEAD_ADMIN_PASSWORD="ChangeMeOnFirstLogin!"
SCHOOL_HEAD_ADMIN_NAME="Head Administrator"
SCHOOL_WHATSAPP_NUMBER=""
SCHOOL_WHATSAPP_DEFAULT_MESSAGE="Hello, I would like to enquire about Splendor Nursery and Primary School."

# Resend (OTP verify + password reset). Without this, OTP/tokens show once in the UI for local recovery.
RESEND_API_KEY=""
EMAIL_FROM="Portal <onboarding@resend.dev>"
SCHOOL_EMAIL_FROM="Splendor School <onboarding@resend.dev>"
NGO_EMAIL_FROM="Splendor NGO <onboarding@resend.dev>"
# Or SMTP:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SECURE="false"

# --- NGO (apps/ngo/.env) ---
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/splendor_ngo?schema=public"
NEXTAUTH_SECRET="replace-with-different-long-random-string"
NEXTAUTH_URL="http://localhost:3001"
NGO_APP_URL="http://localhost:3001"
NGO_HEAD_ADMIN_EMAIL="admin@ngo.local"
NGO_HEAD_ADMIN_PASSWORD="ChangeMeOnFirstLogin!"
NGO_HEAD_ADMIN_NAME="NGO Administrator"
NGO_WHATSAPP_NUMBER=""
NGO_WHATSAPP_DEFAULT_MESSAGE="Hello, I would like to learn more about your organisation."

PAYMENT_PROVIDER="paystack"
PAYMENT_CURRENCY="NGN"

PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxx"
PAYSTACK_WEBHOOK_SECRET=""

FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxx"
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxx"
FLUTTERWAVE_WEBHOOK_SECRET=""
